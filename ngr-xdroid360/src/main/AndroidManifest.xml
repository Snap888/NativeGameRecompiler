<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:largeHeap="true" android:extractNativeLibs="true">
        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" android:value="1" />
        <activity android:name="com.udarmolota.xdroid360.LauncherActivity"
            android:label="@string/app_name" android:theme="@style/LauncherTheme"
            android:exported="false" />
        <activity android:name="com.udarmolota.xdroid360.BugReportActivity"
            android:theme="@style/LauncherTheme" android:exported="false" />
        <activity android:name="com.udarmolota.xdroid360.PadEditorActivity"
            android:screenOrientation="landscape" android:theme="@style/AppTheme" android:exported="false" />
        <activity android:name="com.udarmolota.xdroid360.InstanceActivity"
            android:theme="@style/LauncherTheme" android:exported="false" />
        <activity android:name="com.udarmolota.xdroid360.BuildActivity"
            android:theme="@style/LauncherTheme" android:exported="false" />
        <service android:name="com.udarmolota.xdroid360.BuildService"
            android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name="com.udarmolota.xdroid360.GameActivity"
            android:label="@string/app_name" android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:screenOrientation="landscape" android:exported="false" />
    </application>
</manifest>
