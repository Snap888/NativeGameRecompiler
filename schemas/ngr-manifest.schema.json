{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snap888.github.io/NativeGameRecompiler/schemas/ngr-manifest.schema.json",
  "title": "NGR Package Manifest",
  "type": "object",
  "required": ["formatVersion", "packageId", "displayName", "backend", "entryPoint", "files"],
  "properties": {
    "formatVersion": { "type": "integer", "const": 1 },
    "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string" },
    "backend": {
      "type": "object",
      "required": ["id", "version", "targetAbi"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "targetAbi": { "type": "string", "enum": ["arm64-v8a"] },
        "sourcePlatform": { "type": "string" },
        "sourceArchitecture": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entryPoint": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "minimumRuntimeVersion": { "type": "string" },
    "graphics": {
      "type": "object",
      "properties": {
        "api": { "type": "string" },
        "requiredExtensions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "string" }
  },
  "additionalProperties": false
}
